# Copy to .env and fill in. .env is git-ignored - never commit real keys.
#
# Any OpenAI-compatible chat-completions API works. LLM_BASE_URL is the part
# before /chat/completions, for example:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1   (any non-empty LLM_API_KEY)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-id

# Optional
# LLM_TIMEOUT_SECONDS=30
# json_schema = provider enforces the output schema (preferred).
# json_object = for providers without JSON-schema support; the schema goes in the prompt.
# LLM_RESPONSE_FORMAT=json_schema
# For reasoning models: sent as reasoning_effort when set. "none" stops hidden thinking from
# consuming the output token budget (supported values depend on the provider/model).
# LLM_REASONING_EFFORT=none

# --- HTTP API (FastAPI) ---
# Browser origins allowed by CORS, comma-separated. "*" is rejected.
# Default: http://localhost:5173 (the Vite dev server). Not needed when FastAPI serves the built frontend itself.
# FRONTEND_ORIGIN=http://localhost:5173
# Folder with the built frontend to serve at "/". Default: frontend/dist when it exists.
# FRONTEND_DIST=frontend/dist
