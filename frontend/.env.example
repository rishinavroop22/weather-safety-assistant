# Frontend settings (Vite). Copy to frontend/.env.local if you need to change them.
# Never put LLM or provider keys here: everything in VITE_* ends up in the browser bundle.

# Leave empty to use same-origin requests (the dev proxy below, or FastAPI serving the built app).
# Set to call the API on another origin, e.g. http://localhost:8000 (then FastAPI's
# FRONTEND_ORIGIN must include this frontend's origin).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api and /health (development only).
VITE_DEV_PROXY_TARGET=http://localhost:8000
